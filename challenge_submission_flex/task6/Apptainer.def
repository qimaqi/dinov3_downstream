Bootstrap: docker
From: pytorch/pytorch:2.11.0-cuda12.6-cudnn9-runtime

%labels
    Author FOMO26 Challenge
    Version v1.0.0
    Description FOMO26 Tasks 6 & 7 - DINOv3 patch_cls embedding extraction

%environment
    export PYTHONUNBUFFERED=1
    export LC_ALL=C.UTF-8
    export DINOV3_2D_CHECKPOINT=/app/weights/2D_final_model.pth
    export TASK6_SLICE_POOL=patch_cls
    export TASK6_MODALITY_POOL=each
    export TASK6_TARGET_SPACING_XY=1.0,1.0
    export TASK6_PAD_HW=256,256
    export TASK6_RESIZE_HW=none
    export TASK6_SLICE_BATCH_SIZE=32

%files
    ./predict.py /app/predict.py
    ./requirements.txt /app/requirements.txt
    ./dinov3_downstream/flexi_ct /app/dinov3_downstream/flexi_ct
    ./dinov3_downstream/downstream/__init__.py /app/dinov3_downstream/downstream/__init__.py
    ./dinov3_downstream/downstream/3d_classify /app/dinov3_downstream/downstream/3d_classify
    ./weights/2D_final_model.pth /app/weights/2D_final_model.pth

%post
    mkdir -p /input /output /app
    pip install --no-cache-dir -U pip
    pip install --no-cache-dir -r /app/requirements.txt
    chmod +x /app/predict.py

%runscript
    exec python /app/predict.py "$@"

%help
    FOMO26 Tasks 6 & 7: extract frozen DINOv3 patch_cls embeddings.

    Build:
        apptainer build --fakeroot task6_embedding.sif Apptainer.def --arch amd64

    Run with a single image:
        apptainer run --nv \
            --bind /path/to/input:/input:ro \
            --bind /path/to/output:/output \
            task6_embedding.sif \
            --input /input/scan.nii.gz \
            --output /output/embedding.npy

    Run with Task 1-style modalities:
        apptainer run --nv \
            --bind /path/to/input:/input:ro \
            --bind /path/to/output:/output \
            task6_embedding.sif \
            --flair /input/flair.nii.gz \
            --dwi /input/dwi.nii.gz \
            --t2s /input/t2s.nii.gz \
            --swi /input/swi.nii.gz \
            --output /output/embedding.npy
