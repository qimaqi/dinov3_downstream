Bootstrap: docker
From: pytorch/pytorch:2.11.0-cuda12.6-cudnn9-runtime

%labels
    Author FOMO26 Challenge
    Version v1.0.0
    Description FOMO26 Task 5 - Polymicrogyria Classification (FlexiCT cls, ensemble)

%environment
    export PYTHONUNBUFFERED=1
    export LC_ALL=C.UTF-8
    export PYTHONDONTWRITEBYTECODE=1
    # FlexiCT 2D backbone checkpoint path inside the container
    export FLEXICT_2D_CHECKPOINT=/app/weights/2D_final_model.pth

%files
    # ── Main inference script ─────────────────────────────────────────────────
    ./predict.py /app/predict.py
    ./requirements.txt /app/requirements.txt

    # ── FlexiCT encoder source code ──────────────────────────────────────────
    ./dinov3_downstream/flexi_ct /app/dinov3_downstream/flexi_ct

    # ── Downstream classification code (model architecture) ──────────────────
    ./dinov3_downstream/downstream/__init__.py /app/dinov3_downstream/downstream/__init__.py
    ./dinov3_downstream/downstream/3d_classify /app/dinov3_downstream/downstream/3d_classify

    # ── Model weights ─────────────────────────────────────────────────────────
    # Pretrained FlexiCT 2D backbone (shared across all folds)
    ./weights/2D_final_model.pth /app/weights/2D_final_model.pth

    # Trained classifier checkpoints — one per fold for ensemble
    # Only include the folds you have; predict.py auto-detects which exist
    ./weights/fold_0/best.pt /app/weights/fold_0/best.pt
    ./weights/fold_1/best.pt /app/weights/fold_1/best.pt
    ./weights/fold_2/best.pt /app/weights/fold_2/best.pt
    ./weights/fold_3/best.pt /app/weights/fold_3/best.pt
    ./weights/fold_4/best.pt /app/weights/fold_4/best.pt

%post
    mkdir -p /input /output /app
    pip install --no-cache-dir -U pip
    pip install --no-cache-dir -r /app/requirements.txt
    chmod +x /app/predict.py

%runscript
    exec python /app/predict.py "$@"

%help
    FOMO26 Task 5: Polymicrogyria Classification (Binary)
    Model: FlexiCT 2D encoder + cross-slice pooling (cls) + classifier
    Ensemble: averages predictions across multiple fold checkpoints

    Build:
        apptainer build --fakeroot task5_polymicrogyria.sif Apptainer.def --arch amd64

    Run:
        apptainer run --nv \
            --bind /path/to/input:/input:ro \
            --bind /path/to/output:/output \
            task5_polymicrogyria.sif \
            --t1 /input/t1.nii.gz \
            --output /output/prediction.txt
