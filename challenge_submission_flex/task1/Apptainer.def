Bootstrap: docker
From: pytorch/pytorch:2.11.0-cuda12.6-cudnn9-runtime

%labels
    Author FOMO26 Challenge
    Version v1.0.0
    Description FOMO26 Task 1 - Infarct Detection (FlexiCT patch_cls, ensemble)

%environment
    export PYTHONUNBUFFERED=1
    export LC_ALL=C.UTF-8
    export PYTHONDONTWRITEBYTECODE=1
    # FlexiCT 2D backbone checkpoint path inside the container
    export FLEXICT_2D_CHECKPOINT=/app/weights/2D_final_model_fomo100k_gram.pth
    export TASK1_MODEL_ROOT=/app/weights

%files
    # ── Main inference script ─────────────────────────────────────────────────
    ./predict.py /app/predict.py
    ./requirements.txt /app/requirements.txt

    # ── FlexiCT encoder source code (from repo root) ─────────────────────────
    ../../flexi_ct /app/flexi_ct

    # ── Downstream classification code (model architecture) ──────────────────
    ../../downstream/__init__.py /app/downstream/__init__.py
    ../../downstream/3d_classify /app/downstream/3d_classify

    # ── Model weights ─────────────────────────────────────────────────────────
    # Pretrained FlexiCT 2D backbone (shared across all folds)
    ./weights/2D_final_model_fomo100k_gram.pth /app/weights/2D_final_model_fomo100k_gram.pth

    # Trained classifier checkpoints — top 3 folds for ensemble
    ./weights/fold_0/best.pt /app/weights/fold_0/best.pt
    ./weights/fold_4/best.pt /app/weights/fold_4/best.pt
    ./weights/fold_1/best.pt /app/weights/fold_1/best.pt
    ./weights/fold_0/metrics.json /app/weights/fold_0/metrics.json
    ./weights/fold_4/metrics.json /app/weights/fold_4/metrics.json
    ./weights/fold_1/metrics.json /app/weights/fold_1/metrics.json

%post
    mkdir -p /input /output /app
    # Remove PEP 668 "externally-managed" marker so pip works inside the container
    rm -f /usr/lib/python*/EXTERNALLY-MANAGED
    pip install --no-cache-dir -U pip
    pip install --no-cache-dir -r /app/requirements.txt
    chmod +x /app/predict.py

%runscript
    exec python /app/predict.py "$@"

%help
    FOMO26 Task 1: Infarct Detection (Binary Classification)
    Model: FlexiCT 2D encoder + cross-slice pooling (patch_cls) + classifier
    Ensemble: averages predictions across the 3 best folds

    Build (from challenge_submission_flex/task1/):
        apptainer build --fakeroot task1_infarct.sif Apptainer.def --arch amd64

    Run:
        apptainer run --nv \
            --bind /path/to/input:/input:ro \
            --bind /path/to/output:/output \
            task1_infarct.sif \
            --flair /input/flair.nii.gz \
            --adc /input/adc.nii.gz \
            --dwi /input/dwi.nii.gz \
            --t2s /input/t2s.nii.gz \
            --swi /input/swi.nii.gz \
            --output /output/prediction.txt
