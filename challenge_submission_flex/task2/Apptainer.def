Bootstrap: docker
From: pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

%labels
    Author FOMO26 Challenge
    Version v1.0.0
    Description FOMO26 Task 2 - Meningioma segmentation with MedDINOv3 nnU-Net

%environment
    export PYTHONUNBUFFERED=1
    export LC_ALL=C.UTF-8
    export PYTHONDONTWRITEBYTECODE=1
    export MPLCONFIGDIR=/tmp/meddinov3_mplconfig
    export DINOV3_2D_CHECKPOINT=/app/weights/dinov3_vitb16_pretrain_lvd1689m-73cec8be.pth
    export nnUNet_compile=false

%files
    ./predict.py /app/predict.py
    ./requirements.txt /app/requirements.txt
    ./nnUNet /app/nnUNet
    ./weights /app/weights

%post
    mkdir -p /app /input /output /tmp/meddinov3_mplconfig
    pip install --no-cache-dir --upgrade pip
    pip install --no-cache-dir -r /app/requirements.txt
    pip install --no-cache-dir -e /app/nnUNet
    chmod +x /app/predict.py

%runscript
    exec python /app/predict.py "$@"

%help
    FOMO26 Task 2: FLAIR-only meningioma segmentation.
    Model folder: dinov3_base_primus_Trainer_freeze_multi__nnUNetPlans__2d
    Checkpoint: fold_0/checkpoint_best.pth

    Build:
        apptainer build --fakeroot task2_meningioma.sif Apptainer.def --arch amd64

    Run:
        apptainer run --nv \
            --bind /path/to/input:/input:ro \
            --bind /path/to/output:/output \
            task2_meningioma.sif \
            --flair /input/flair.nii.gz \
            --output /output/segmentation.nii.gz
